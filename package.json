{
  "name": "spv-store",
  "description": "SPV (Simplified Payment Verification) store for Bitcoin SV with IndexedDB persistence",
  "author": "David Case",
  "contributors": ["Satchmo"],
  "repository": {
    "type": "git",
    "url": "https://github.com/b-open-io/spv-store.git"
  },
  "homepage": "https://github.com/b-open-io/spv-store",
  "bugs": {
    "url": "https://github.com/b-open-io/spv-store/issues"
  },
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    "require": "./dist/index.cjs",
    "default": "./dist/index.modern.js"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.module.js",
  "unpkg": "dist/index.umd.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts && npm pack",
    "prepare": "bun run scripts/build.ts",
    "clean": "rm -rf dist",
    "format": "tsfmt -r",
    "test": "jest",
    "docs": "typedoc"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "peerDependencies": {
    "@bsv/sdk": "^1.8.3"
  },
  "devDependencies": {
    "@bsv/sdk": "^1.8.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.0",
    "globals": "^16.4.0",
    "jsdoc-to-markdown": "^9.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-formatter": "^7.2.2"
  }
}
